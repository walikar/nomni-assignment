PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketplace_orders
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/marketplace_orders_test

# Uber: X-Uber-Signature = hex(HMAC-SHA256(client_secret, raw body))
UBER_CLIENT_SECRET=dev-uber-client-secret
# Bearer token for GET /v2/eats/order/{id} (scope eats.order). Obtaining it via
# client_credentials is out of scope; paste one here for a real account.
UBER_ACCESS_TOKEN=dev-uber-access-token
# MOCK_UBER=1 serves fixtures/uber/get-order.json at /mock/uber and, unless
# UBER_API_BASE is set, points Get Order at it. For the real API:
#   MOCK_UBER=0 and UBER_API_BASE=https://api.uber.com
MOCK_UBER=1

# DoorDash: the Auth Token configured on the webhook subscription in the Developer Portal.
# DoorDash sends it in the Authorization header.
DOORDASH_WEBHOOK_TOKEN=dev-doordash-token

# Comma-separated origins allowed to call /api (the admin).
ADMIN_ORIGIN=http://localhost:3000

# Enables POST /api/demo/orders and the "Try it" panel in the admin.
DEMO_MODE=1
